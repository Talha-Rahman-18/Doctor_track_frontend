# Base URL of the REST API as seen by the BROWSER.
# Leave as /api/v1: Next.js rewrites /api/* to the Express server (see next.config.mjs).
# For a separate API origin use the full URL, e.g. https://api.example.com/api/v1
# NOTE: NEXT_PUBLIC_* variables are bundled into public browser code. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=

# Server-side only (used by the Next.js rewrite). Where Express is running.
API_PROXY_TARGET=
